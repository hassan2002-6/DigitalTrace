
{
  "name": "digitaltrace",
  "version": "1.0.0",
  "private": true,
  "description": "DigitalTrace - browser history analyzer (Full Stack course project)",
  "scripts": {
    "install:all": "npm --prefix backend install && npm --prefix frontend install",
    "dev:backend": "npm --prefix backend run dev",
    "dev:frontend": "npm --prefix frontend run dev",
    "dev:members": "npm --prefix frontend run dev:shared",
    "start:backend": "npm --prefix backend start",
    "db:migrate": "npm --prefix backend run db:migrate",
    "build": "npm --prefix frontend run build",
    "test": "npm --prefix backend test"
  }
}
