# DigitalTrace backend configuration
# Copy this file to backend/.env and fill in your local MySQL credentials.

# HTTP server
PORT=5000

# Comma-separated list of origins allowed to call the API
CLIENT_ORIGIN=http://localhost:5173

# Neon PostgreSQL
# Pooled connection string (host contains "-pooler") used by the API.
DATABASE_URL=postgresql://user:password@ep-xxxx-pooler.region.aws.neon.tech/digitaltrace?sslmode=require

# Direct connection string used only by migrations (npm run db:migrate).
DIRECT_URL=postgresql://user:password@ep-xxxx.region.aws.neon.tech/digitaltrace?sslmode=require

# Set to "disable" only for a local PostgreSQL without TLS.
# PGSSL=disable

# Required by jsonwebtoken - use a long random value, never commit it
JWT_SECRET=change_me_to_a_long_random_string
